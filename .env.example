# =============================================================================
# Tech Office Cockpit — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# NE JAMAIS commiter le fichier .env
# =============================================================================

# --- Jira ---
JIRA_BASE_URL=https://votre-instance.atlassian.net
JIRA_EMAIL=svc-techoffice@votre-entreprise.com
JIRA_API_TOKEN=                        # PAT ou API Token Jira
JIRA_AUTH_TYPE=token                   # 'token' ou 'oauth2'
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_TOKEN_URL=https://auth.atlassian.com/oauth/token
JIRA_REQUEST_TIMEOUT=30
JIRA_MAX_RETRIES=4

# --- Rovo ---
ROVO_API_BASE_URL=https://api.atlassian.com/rovo/v1
ROVO_API_TOKEN=
ROVO_ENABLED=true

# --- LLM Backend ---
# Provider: 'anthropic' | 'azure_openai' | 'local'
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192

# Azure OpenAI (alternatif)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Embedding Model ---
# 'local' (multilingual-e5-large) ou 'openai'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
# Si openai :
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                        # Si mode cloud
QDRANT_COLLECTION_ARCHITECTURE=architecture_docs
QDRANT_COLLECTION_GOVERNANCE=governance_docs
QDRANT_COLLECTION_JIRA=jira_tickets
QDRANT_COLLECTION_DELIVERABLES=deliverables

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=techoffice_cockpit
POSTGRES_USER=techoffice
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://techoffice:password@localhost:5432/techoffice_cockpit

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO (stockage objets) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_DELIVERABLES=deliverables
MINIO_BUCKET_DOCUMENTS=documents
MINIO_SECURE=false

# --- Application ---
APP_ENV=development                    # 'development' | 'staging' | 'production'
APP_SECRET_KEY=                        # Clé aléatoire 32+ caractères
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# --- Observabilité ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ENABLE_TRACING=false

# --- Pipeline RAG ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_SCORE_THRESHOLD=0.65
